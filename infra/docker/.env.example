# --- Base de datos (MariaDB) ---
DB_DATABASE=database
DB_USERNAME=user
DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=root_password

# --- DuckDNS (dominio dinámico) ---
# Solo el subdominio, sin ".duckdns.org"
# Solo para produccion (perfil "prod"): actualiza el DNS dinamico
DUCKDNS_DOMAINS=tu-subdominio
DUCKDNS_TOKEN=token

# --- Backend ---
# Opcional: el pago con tarjeta esta en modo demostracion y no cobra
STRIPE_SECRET_KEY=stripe_sk
JWT_SECRET=token_jwt

# Datos de demostracion (opcional, desactivado por defecto): carga productos y
# mesas de ejemplo y crea un administrador con la contrasena que pongas aqui
APP_SEED_DEMO=false
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=
