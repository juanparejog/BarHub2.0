# --- Base de datos (MariaDB) ---
DB_DATABASE=database
DB_USERNAME=user
DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=root_password

# --- Dominio (solo produccion) ---
# En local no hace falta nada: Caddy sirve http://localhost.
# En produccion, define el dominio completo para que Caddy consiga el certificado
# HTTPS y el backend acepte ese origen (lista separada por comas).
# SITE_ADDRESS=tu-subdominio.duckdns.org
# CORS_ALLOWED_ORIGINS=http://localhost:4200,https://tu-subdominio.duckdns.org

# Politica de seguridad de contenido (CSP). Por defecto se aplica. Para probar un cambio de la
# aplicacion sin romper nada, Content-Security-Policy-Report-Only solo avisa: el navegador carga todo
# y las infracciones llegan al log del backend ("CSP:").
# CSP_CABECERA=Content-Security-Policy-Report-Only

# --- DuckDNS (dominio dinámico) ---
# Solo el subdominio, sin ".duckdns.org"
# Solo para produccion (perfil "prod"): actualiza el DNS dinamico
DUCKDNS_DOMAINS=tu-subdominio
DUCKDNS_TOKEN=token

# --- Backend ---
# Opcional: el pago con tarjeta esta en modo demostracion y no cobra
STRIPE_SECRET_KEY=stripe_sk
JWT_SECRET=token_jwt

# Clave para cifrar los secretos de la verificacion en dos pasos (genera una con
# openssl rand -base64 32). Si se deja vacia se deriva de JWT_SECRET. No la cambies
# despues: quien tenga la verificacion activada tendria que configurarla de nuevo
APP_TOTP_CLAVE=

# Datos de demostracion (opcional, desactivado por defecto): carga productos y
# mesas de ejemplo y crea un administrador con la contrasena que pongas aqui
APP_SEED_DEMO=false
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=

# Correo (confirmacion de cuenta y recuperacion de contrasena). Sin estas variables, los
# correos van a Mailpit, que los captura en local: bandeja en http://localhost:8025.
# En produccion, el SMTP real (por ejemplo, el de tu proveedor de correo):
# MAIL_HOST=smtp.tu-proveedor.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario
# MAIL_PASSWORD=clave
# MAIL_STARTTLS=true
# APP_CORREO_REMITENTE=BarHub <no-responder@tu-dominio.com>

# --- SOC (perfil "soc": Loki, Alloy, Alertmanager y Grafana) ---
# Se despliega con: python3 seguridad/soc/soc.py desplegar --aplicar (ver docs/seguridad.md)
# Contrasena del administrador de Grafana (http://127.0.0.1:3000), obligatoria: openssl rand -base64 18
SOC_GRAFANA_CLAVE=
# SOC_GRAFANA_USUARIO=admin
# Las alertas van por correo. Sin estas variables, a Mailpit (http://localhost:8025).
# En produccion, el SMTP real (puede ser el mismo que MAIL_*):
# SOC_SMTP_HOST=smtp.tu-proveedor.com
# SOC_SMTP_PUERTO=587
# SOC_SMTP_USUARIO=usuario
# SOC_SMTP_CLAVE=clave
# SOC_SMTP_TLS=true
# SOC_CORREO_DESTINO=gerencia@tu-dominio.com
# SOC_CORREO_REMITENTE=BarHub SOC <soc@tu-dominio.com>
# Opcional, tambien por Telegram: token del bot (de @BotFather) e id numerico del chat
# SOC_TELEGRAM_TOKEN=
# SOC_TELEGRAM_CHAT=
