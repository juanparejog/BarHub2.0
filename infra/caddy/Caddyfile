# Configuracion comun a produccion y local
(app) {
    # Comprime los textos, pero no los avisos en tiempo real (text/event-stream): comprimidos,
    # el navegador los recibiria a trozos y con retraso. Por eso la lista es explicita y no text/*.
    encode {
        zstd
        gzip
        match {
            header Content-Type text/html*
            header Content-Type text/css*
            header Content-Type text/plain*
            header Content-Type text/javascript*
            header Content-Type application/javascript*
            header Content-Type application/json*
            header Content-Type application/manifest+json*
            header Content-Type application/xml*
            header Content-Type image/svg+xml*
            header Content-Type image/x-icon*
            header Content-Type image/vnd.microsoft.icon*
        }
    }

    # Logs de acceso en JSON (los usara el SOC y Fail2Ban)
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }

    # El actuator solo es accesible desde dentro de la red de Docker
    handle /api/actuator/* {
        respond "Not found" 404
    }

    # API: se quita el prefijo /api antes de llegar al backend
    handle_path /api/* {
        reverse_proxy backend:8080
    }

    # Imagenes subidas desde la app (volumenes). Si no existe el fichero,
    # se pide al frontend (imagenes de demo incluidas en el build)
    @subidas path /assets/images/usuarios/* /assets/images/productos/*
    handle @subidas {
        route {
            root * /srv/uploads
            file_server {
                pass_thru
            }
            reverse_proxy frontend:80
        }
    }

    # Todo lo demas es el frontend
    handle {
        reverse_proxy frontend:80
    }
}

# Politica de seguridad de contenido (CSP):
# - scripts solo de la propia web (ni inline ni eval) y de Stripe, que carga el formulario de pago;
# - estilos inline permitidos: Angular inserta los de cada componente en <style> y Bootstrap usa el
#   atributo style. Un estilo inyectado no ejecuta codigo;
# - Google Maps (mapa del local en un iframe). Las fuentes y los iconos son de la propia web (sin Google
#   Fonts) y los QR de las mesas y de la verificacion en dos pasos se dibujan en el navegador (data:);
# - nadie puede meter la web en un iframe, ni cambiar <base>, ni enviar formularios fuera;
# - las infracciones se envian a /api/csp-informe, que las anota en el log del backend. Solo
#   report-uri: con report-to, Chrome deja de usar report-uri y entrega los avisos tarde o nunca.
(csp) {
    header {$CSP_CABECERA:Content-Security-Policy} "default-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.stripe.com; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-informe"
}

# Direccion del sitio. En local vale http://localhost (sin HTTPS), que es el valor
# por defecto. En produccion se define SITE_ADDRESS=tu-dominio en el .env y Caddy
# obtiene y renueva el certificado solo. Las cabeceras de seguridad se aplican siempre.
# CSP_CABECERA=Content-Security-Policy-Report-Only en el .env deja la CSP solo en modo aviso.
{$SITE_ADDRESS:http://localhost} {
    import app
    import csp
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy `camera=(), microphone=(), geolocation=(), payment=(self "https://js.stripe.com")`
        -Server
    }
}
