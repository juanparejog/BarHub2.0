# Configuración común a producción y local
(app) {
    encode zstd gzip

    # Comandas en tiempo real (Socket.IO)
    handle /socket.io/* {
        reverse_proxy backend:9092
    }

    # API: se quita el prefijo /api antes de llegar al backend
    handle_path /api/* {
        reverse_proxy backend:8080
    }

    # Todo lo demás es el frontend
    handle {
        reverse_proxy frontend:80
    }
}

# Producción: Caddy obtiene y renueva el certificado solo
barhub2.duckdns.org {
    import app
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# Pruebas en local, sin HTTPS
http://localhost {
    import app
}