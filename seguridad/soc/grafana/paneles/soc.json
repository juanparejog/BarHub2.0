      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({servicio=\"caddy\"} | json estado=\"status\" | estado >= 500 [$__range]))",
          "queryType": "instant"
