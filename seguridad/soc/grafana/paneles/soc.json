{
  "uid": "barhub-soc",
  "title": "BarHub - SOC",
  "description": "Seguridad de BarHub: autenticacion, accesos, trafico y CSP. Las alertas activas estan en Alertmanager (http://127.0.0.1:9093).",
  "tags": [
    "barhub",
    "soc",
    "seguridad"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inicios de sesion fallidos",
      "description": "Inicio de sesion, segundo paso y reautenticacion rechazados o bloqueados en el periodo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({servicio=\"backend\"} |= \"evento=auditoria\" | logfmt | accion=~\"INICIO_SESION|SEGUNDO_PASO|REAUTENTICACION\" | resultado=~\"RECHAZADO|BLOQUEADO\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
