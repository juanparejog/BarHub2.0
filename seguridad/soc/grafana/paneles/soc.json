    {
      "id": 5,
      "type": "timeseries",
      "title": "Auditoria: lo que no ha salido bien",
      "description": "Entradas del registro de auditoria rechazadas, bloqueadas o con error",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (accion, resultado) (count_over_time({servicio=\"backend\"} |= \"evento=auditoria\" | logfmt | resultado!=\"CORRECTO\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{accion}} {{resultado}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Respuestas de Caddy por codigo",
      "description": "Todas las peticiones a la web, por codigo de respuesta",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (estado) (count_over_time({servicio=\"caddy\"} | json estado=\"status\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{estado}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "IP con mas fallos de autenticacion",
      "description": "Las 10 IP con mas inicios de sesion fallidos o bloqueados en el periodo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (ip) (count_over_time({servicio=\"backend\"} |= \"evento=auditoria\" | logfmt | accion=~\"INICIO_SESION|SEGUNDO_PASO|REAUTENTICACION\" | resultado=~\"RECHAZADO|BLOQUEADO\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ip": "IP",
              "Value": "Peticiones",
              "Value #A": "Peticiones"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Peticiones",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "IP con mas respuestas 4xx",
      "description": "Las 10 IP con mas respuestas 400-499 en el periodo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (ip) (count_over_time({servicio=\"caddy\"} | json ip=\"request.client_ip\", estado=\"status\" | estado >= 400 | estado < 500 [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ip": "IP",
              "Value": "Peticiones",
              "Value #A": "Peticiones"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Peticiones",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
